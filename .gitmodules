[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "pslr"]
	path = pslr
	url = https://gitlab.com/bart-turczynski/pslr
[submodule "punycoder"]
	path = punycoder
	url = https://github.com/cran/punycoder
[submodule "rurl"]
	path = rurl
	url = https://gitlab.com/bart-turczynski/rurl
